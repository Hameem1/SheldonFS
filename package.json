{
  "name": "sheldonfs",
  "version": "0.1.0",
  "description": "Cross-platform file organization and management system",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "bundle": "tsdown",
    "dev": "tsx src/cli/index.ts",
    "start": "npm run bundle && node build/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "nuke": "rm -rf node_modules build package-lock.json *.tsbuildinfo",
    "clean-install": "npm run nuke && npm install"
  },
  "keywords": [
    "file-management",
    "organization",
    "duplicate-detection",
    "cross-platform"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.9.2",
    "@vitest/coverage-v8": "^4.0.8",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "tsdown": "^0.15.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.2.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.6"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "file-type": "^21.0.0",
    "mime": "^4.1.0"
  }
}
